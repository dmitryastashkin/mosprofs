class Punch:
    def init(self, par, sim, th, sf, exit):
        self.sim=sim; self.th=th; self.sf=sf; self.exit=exit
        self.lh=0; self.rh=0; self.mh=5; self.sc=0
        self.lt=random.randint(20,80); self.rt=random.randint(20,80)
        self.ll=0; self.lr=0; self.run=True
        self.w=tk.Toplevel(par); self.w.title("Удар"); self.w.geometry("700x500")
        self.c=tk.Canvas(self.w, width=700, height=300, bg="lightyellow"); self.c.pack()
        self.lp=self.c.create_oval(100,100,250,250, fill="red")
        self.rp=self.c.create_oval(450,100,600,250, fill="red")
        self.tl=tk.Label(self.w, text=f"Левая цель: {self.lt}%  |  Правая цель: {self.rt}%", font=("Arial",14)); self.tl.pack()
        self.hl=tk.Label(self.w, text=f"Левая: 0/5  |  Правая: 0/5  |  Счёт: 0", font=("Arial",14)); self.hl.pack()
        tk.Button(self.w, text="Выход", command=self._exit).pack()
        speak("Режим Сила удара. Бейте по грушам с нужной силой. 5 ударов каждой рукой.")
        self._loop()
    def _loop(self):
        if not self.run: return
        l,r=self.sim.get()
        lp=norm(l,self.th["mn_l"],self.th["mx_l"]); rp=norm(r,self.th["mn_r"],self.th["mx_r"])
        now=time.time()
        if lp>15 and self.lh<self.mh and now-self.ll>1.0: self._hit("l",lp,now)
        if rp>15 and self.rh<self.mh and now-self.lr>1.0: self._hit("r",rp,now)
        self.hl.config(text=f"Левая: {self.lh}/5  |  Правая: {self.rh}/5  |  Счёт: {self.sc}")
        if self.lh>=self.mh and self.rh>=self.mh:
            self.run=False; speak(f"Режим завершён. Ваш счёт — {self.sc} очков."); return
        self.w.after(33, self._loop)
    def _hit(self, h, f, now):
        if h=="l":
            self.lh+=1; self.ll=now; e=abs(f-self.lt); p=max(0,int(100-e))
            self.sc+=p; log(self.sf,int(f),0,"punch_l",self.lt,p)
            speak("Левый удар"); self.lt=random.randint(20,80)
        else:
            self.rh+=1; self.lr=now; e=abs(f-self.rt); p=max(0,int(100-e))
            self.sc+=p; log(self.sf,0,int(f),"punch_r",self.rt,p)
            speak("Правый удар"); self.rt=random.randint(20,80)
    def _exit(self): self.run=False; self.w.destroy(); self.exit()

class App:
    def init(self):
        init_db(); self.root=tk.Tk(); self.root.title("Нейрореабилитация"); self.root.geometry("500x400")
        self.sim=Sim(); self.sim.start(); self.op=None; self.sf=None; self.th=None
        self._menu()
    def _menu(self):
        for w in self.root.winfo_children(): w.destroy()
        tk.Label(self.root, text="Нейрореабилитация", font=("Arial",20,"bold")).pack(pady=30)
        tk.Button(self.root, text="Регистрация", font=("Arial",14), width=20, command=self._reg).pack(pady=10)
        tk.Button(self.root, text="Авторизация", font=("Arial",14), width=20, command=self._login).pack(pady=10)
        tk.Button(self.root, text="Выход", font=("Arial",12), width=20, command=self._exit).pack(pady=20)
    def _reg(self):
        for w in self.root.winfo_children(): w.destroy()
        tk.Label(self.root, text="Регистрация", font=("Arial",18)).pack(pady=10)
        for t in ["Фамилия:","Имя:","Отчество (необязательно):","Возраст (14-100):"]:
            tk.Label(self.root, text=t).pack()
        self.e1=tk.Entry(self.root, width=30); self.e1.pack()
        self.e2=tk.Entry(self.root, width=30); self.e2.pack()
        self.e3=tk.Entry(self.root, width=30); self.e3.pack()
        self.e4=tk.Entry(self.root, width=30); self.e4.pack()
        tk.Button(self.root, text="Зарегистрировать", command=self._do_reg).pack(pady=15)
        tk.Button(self.root, text="Назад", command=self._menu).pack()
    def _do_reg(self):
        ln=self.e1.get().strip(); fn=self.e2.get().strip(); pn=self.e3.get().strip(); ag=self.e4.get().strip()
        if not ln or not fn or not ag: speak("Заполните фамилию, имя, возраст."); return
        try:
            age=int(ag)
            if age<14 or age>100: raise ValueError
        except: speak("Возраст должен быть числом от 14 до 100."); return
        nid=reg(ln,fn,pn,age); speak("Регистрация успешна")
        for w in self.root.winfo_children(): w.destroy()
        tk.Label(self.root, text=f"Ваш ID: {nid}", font=("Arial",20,"bold"), fg="green").pack(pady=50)
        tk.Label(self.root, text="Запомните его!").pack()
        tk.Button(self.root, text="В меню", command=self._menu).pack(pady=20)
    def _login(self):
        for w in self.root.winfo_children(): w.destroy()
        tk.Label(self.root, text="Авторизация", font=("Arial",18)).pack(pady=20)
        tk.Label(self.root, text="Введите ID:").pack()
        self.eid=tk.Entry(self.root, width=20, font=("Arial",14)); self.eid.pack()
        tk.Button(self.root, text="Войти", command=self._do_login).pack(pady=15)
        tk.Button(self.root, text="Назад", command=self._menu).pack()
    def _do_login(self):
        oid=self.eid.get().strip()
        if not oid.isdigit(): speak("Оператор не найден, повторите ввод."); return
        op=find_op(oid)
        if op is None: speak("Оператор не найден, повторите ввод."); return
        self.op=op; self.sf=mk_sess(oid)
        speak(f"Приветствую вас в программе реабилитации, {op['firstname']}!")
        self.root.withdraw(); Calib(self.root, self.sim, self.sf, done=self._on_calib)
    def _on_calib(self, th):
        self.th=th; self.root.deiconify(); self._games()
    def _games(self):
        for w in self.root.winfo_children(): w.destroy()
        tk.Label(self.root, text="Выберите режим", font=("Arial",20,"bold")).pack(pady=30)
        tk.Button(self.root, text="Режим 1: Собери яблоки", font=("Arial",14), width=25, command=self._apples).pack(pady=10)
        tk.Button(self.root, text="Режим 2: Сила удара", font=("Arial",14), width=25, command=self._punch).pack(pady=10)
        tk.Button(self.root, text="Выход", font=("Arial",12), width=25, command=self._exit).pack(pady=20)
    def _apples(self): self.root.withdraw(); Apples(self.root, self.sim, self.th, self.sf, exit=self._back)
    def _punch(self): self.root.withdraw(); Punch(self.root, self.sim, self.th, self.sf, exit=self._back)
    def _back(self): self.root.deiconify(); self._games()
    def _exit(self): self.sim.stop(); self.root.destroy()
    def run(self): self.root.mainloop()

if name == "main": App().run()